# Copy to .env. Never commit .env or the data directory.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# Required in production. Generate once; retain a separate recovery copy. Never commit.
PROFILE_ENCRYPTION_KEY_FILE=./secrets/profile-encryption.key
# Exact browser origin. Production must use HTTPS through a trusted reverse proxy.
PUBLIC_ORIGIN=https://fleet.example.org
SECURE_COOKIES=true
# Only set behind the single trusted reverse proxy shown in compose.yml.
TRUST_PROXY=1

# Setup requires the administrator email and name. No built-in accounts or passwords.
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_NAME=
# INITIAL_ADMIN_PASSWORD=

# Disabled until IT supplies an approved sending service and administrator recipients.
EMAIL_PROVIDER=disabled
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Optional Resend transactional email; requires a verified domain and approved account.
RESEND_API_KEY=

# Caddy public HTTPS deployment only. Set an organization-approved DNS hostname.
APP_DOMAIN=fleet.example.org
# BACKUP_DIR must be on an organization-controlled, encrypted separate destination.
BACKUP_DIR=./backups

# Vercel cloud adapter (server-only secrets; never prefix these with VITE_).
# DATABASE_URL=postgresql://fleet_app.PROJECT:password@REGION.pooler.supabase.com:6543/postgres
# DATABASE_SCHEMA=fleet
# PROFILE_ENCRYPTION_KEY=64-character-hex-key
# R2_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com
# R2_BUCKET=fleet-checkout-evidence
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# STORAGE_LIMIT_BYTES=8000000000
# CRON_SECRET=generated-random-secret
